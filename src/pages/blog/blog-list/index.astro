---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postUrl, dateLabel, url } from '@/lib/site';
const posts = (await getCollection('posts')).sort((a,b) => +b.data.date - +a.data.date);
---
<BaseLayout title="Notes & updates" active="notes"><div class="page-heading"><h1>Notes & updates</h1></div><div class="archive-controls"><label for="search">Search notes<input id="search" type="search" placeholder="Search by title or topic…" /></label><a class="text-link" href={url('tags/')}>Browse topics</a></div><p id="result-count" class="eyebrow" aria-live="polite">{posts.length} entries</p><div class="article-list">{posts.map(post => <a data-entry data-search={`${post.data.title} ${post.data.tags.join(' ')} ${post.data.category}`.toLowerCase()} href={postUrl(post)}><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><div><span class="eyebrow">{post.data.category}</span><h2>{post.data.title}</h2><p>{post.data.tags.join(' · ')}</p></div></a>)}</div><p id="empty-state" hidden>No notes match your search. Try another title or topic.</p></BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('#search')!;
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  input.addEventListener('input', () => { const query = input.value.toLowerCase().trim(); let count = 0; entries.forEach(entry => { entry.hidden = !entry.dataset.search!.includes(query); if (!entry.hidden) count++; }); document.querySelector('#result-count')!.textContent = `${count} ${count === 1 ? 'entry' : 'entries'}`; (document.querySelector('#empty-state') as HTMLElement).hidden = count > 0; });
</script>
