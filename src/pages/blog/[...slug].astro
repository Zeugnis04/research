---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Lightbox from '@/components/Lightbox.astro';
import { url, dateLabel } from '@/lib/site';
export async function getStaticPaths() { return (await getCollection('posts')).map(post => ({ params: { slug: `${post.data.category}/${post.data.slug}` }, props: { post } })); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2);
---
<BaseLayout title={post.data.title} description={post.data.description} active={post.data.category === 'research' ? 'research' : 'notes'}><header class="post-heading"><a class="back-link" href={url('blog/blog-list/')}>← All notes</a><p class="eyebrow">{post.data.category} <span> / </span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time></p><h1>{post.data.title}</h1><div class="tags">{post.data.tags.map(tag => <a href={url(`tags/#${tag}`)}>{tag.replaceAll('-', ' ')}</a>)}</div></header><div class="reading-layout"><aside class="toc">{toc.length > 0 && <nav aria-label="On this page"><p class="eyebrow">ON THIS PAGE</p>{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav>}</aside><article class="prose"><Content /><div class="article-end"><a href={url('research/')}>← Explore more research</a><a href={url('cv.html')}>View CV</a></div></article></div><Lightbox /></BaseLayout>
