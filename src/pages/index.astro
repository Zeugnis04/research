---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { Image } from 'astro:assets';
import portrait from '@/assets/img/YBKwon.jpg';
import coast from '@/assets/img/stereo-imaging/IMG_4045_111132.webp';
import { projects } from '@/lib/projects';
import { url } from '@/lib/site';
---
<BaseLayout active="about">
  <section class="hero">
    <div class="hero-copy"><h1>Yeongbin Kwon</h1><div class="hero-actions"><a class="button primary" href={url('research/')}>Explore my research</a><a class="button secondary" href={url('cv.html')}>Curriculum vitae</a></div></div>
    <figure class="hero-visual"><Image src={coast} alt="Breaking waves observed during a coastal field experiment in Manlipo, South Korea" widths={[480, 800, 1200]} sizes="(max-width: 800px) 92vw, 520px" format="webp" loading="eager" fetchpriority="high" /><figcaption>Manlipo, South Korea</figcaption></figure>
  </section>
  <section class="about-section" aria-labelledby="about-title"><div class="section-label"><h2 id="about-title">About me</h2><Image class="portrait" src={portrait} alt="Yeongbin Kwon" width={160} height={160} format="webp" /></div><div class="about-copy"><p>I hold a B.S. in Civil and Environmental Engineering from Seoul National University. My interests span environmental fluid mechanics, coastal processes, and the application of machine learning to climate and energy systems.</p><p>My recent work includes developing low-cost stereo imaging methods to reconstruct nearshore wave fields and studying foundation models for weather forecasting using ERA5 reanalysis data.</p><p class="name-note"><span lang="ko">권영빈</span> · <span lang="zh">權榮彬</span> · [kʷʌn.jʌŋ.bin]</p><div class="social-links"><a href="mailto:ybkwon04@snu.ac.kr">Email</a><a href="https://scholar.google.com/citations?user=KEQmFeUAAAAJ">Google Scholar</a><a href="https://github.com/Zeugnis04/">GitHub</a><a href="https://www.linkedin.com/in/yeongbin-kwon/">LinkedIn</a></div></div></section>
  <section class="work-section" aria-labelledby="work-title"><div class="section-heading"><div><h2 id="work-title">Featured research</h2></div><a class="text-link" href={url('research/')}>All research</a></div><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>
  <section class="news-section" aria-labelledby="news-title"><div class="section-label"><h2 id="news-title">News</h2></div><div class="news-list"><a href={url('cv.html')}><time datetime="2026-02">FEB 2026</time><div><h3>Graduated with honors</h3><p>B.S., summa cum laude, Seoul National University.</p></div></a><a href={url('blog/research/weather-jiu-jitsu-agu25-posters/')}><time datetime="2025-12">DEC 2025</time><div><h3>Weather Jiu-Jitsu at AGU25</h3><p>Two posters on adaptive perturbations and weather systems.</p></div></a><a href={url('blog/news/best-bachelors-thesis-award/')}><time datetime="2025-12">DEC 2025</time><div><h3>Best Bachelor’s Thesis Award</h3><p>Recognizing research in calibration-free coastal stereo imaging.</p></div></a></div></section>
</BaseLayout>
