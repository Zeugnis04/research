---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/lib/projects';
import { getCollection } from 'astro:content';
import { postUrl, dateLabel } from '@/lib/site';
const posts = (await getCollection('posts', p => p.data.category === 'research')).sort((a,b) => +b.data.date - +a.data.date);
---
<BaseLayout title="Research" active="research"><div class="page-heading"><h1>Research</h1></div><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div><section class="archive-section"><div class="section-heading"><h2>Projects & research notes</h2><span class="eyebrow">{posts.length} ENTRIES</span></div><div class="article-list">{posts.map(post => <a href={postUrl(post)}><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><div><h3>{post.data.title}</h3><p>{post.data.tags.join(' · ')}</p></div></a>)}</div></section></BaseLayout>
