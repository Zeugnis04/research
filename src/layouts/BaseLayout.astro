---
import '@/styles/global.css';
import { url, description as siteDescription } from '@/lib/site';
type Props = { title?: string; description?: string; active?: string };
const { title, description = siteDescription, active = '' } = Astro.props;
const pageTitle = title ? `${title} — Yeongbin Kwon` : 'Yeongbin Kwon — Coastal & Climate Research';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  {import.meta.env.PROD && (
    <>
      <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QGXVPV6SN8"></script>
      <script is:inline>
        if (!['localhost', '127.0.0.1', '[::1]'].includes(window.location.hostname)) {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-QGXVPV6SN8');
        }
      </script>
    </>
  )}
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="color-scheme" content="light dark" />
  <title>{pageTitle}</title><link rel="canonical" href={canonical} />
  <meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(url('assets/img/YBKwon.jpg'), Astro.site)} />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="apple-touch-icon" sizes="180x180" href={url('apple-touch-icon.png')} />
  <link rel="alternate" type="application/rss+xml" title="Yeongbin Kwon" href={url('feed.xml')} />
  <link rel="preconnect" href="https://use.typekit.net" crossorigin />
  <script is:inline>
    (() => { let theme; try { theme = localStorage.getItem('theme'); } catch {} document.documentElement.dataset.theme = theme === 'light' || theme === 'dark' ? theme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; })();
  </script>
  <script is:inline>
    (function(d) {
      var config = { kitId: 'isv6esg', scriptTimeout: 3000, async: true },
      h=d.documentElement,t=setTimeout(function(){h.className=h.className.replace(/\bwf-loading\b/g,'')+' wf-inactive';},config.scriptTimeout),tk=d.createElement('script'),f=false,s=d.getElementsByTagName('script')[0],a;
      h.className+=' wf-loading';tk.src='https://use.typekit.net/'+config.kitId+'.js';tk.async=true;
      tk.onload=tk.onreadystatechange=function(){a=this.readyState;if(f||a&&a!='complete'&&a!='loaded')return;f=true;clearTimeout(t);try{Typekit.load(config)}catch(e){}};
      s.parentNode.insertBefore(tk,s);
    })(document);
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header shell">
    <a class="wordmark" href={url()} aria-label="Yeongbin Kwon home"><span class="wordmark-text" aria-hidden="true"><span class="wordmark-initial">y</span><span class="wordmark-reveal"><span>eong</span></span>b<span class="wordmark-reveal"><span>in&nbsp;</span></span><span class="wordmark-initial">k</span><span class="wordmark-reveal"><span>won</span></span></span></a>
    <div class="header-actions">
      <nav aria-label="Main navigation"><a href={url()} aria-current={active === 'about' ? 'page' : undefined}>About</a><a href={url('research/')} aria-current={active === 'research' ? 'page' : undefined}>Research</a><a href={url('blog/blog-list/')} aria-current={active === 'notes' ? 'page' : undefined}>Notes</a><a href={url('cv.html')} aria-current={active === 'cv' ? 'page' : undefined}>CV</a></nav>
      <button class="theme-toggle" aria-label="Switch color theme" title="Switch color theme"><svg class="moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.8 13a9 9 0 0 1-9.8-9.8A9 9 0 1 0 20.8 13Z"/></svg><svg class="sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg></button>
    </div>
  </header>
  <main id="main" class="shell"><slot /></main>
  <footer class="site-footer shell"><div><strong>Yeongbin Kwon</strong></div><div class="footer-links"><a href="mailto:ybkwon04@snu.ac.kr">Email</a><a href="https://github.com/Zeugnis04/">GitHub</a><a href={url('feed.xml')}>RSS</a><span>© {new Date().getFullYear()}</span></div></footer>
  <script>
    const wordmark = document.querySelector<HTMLAnchorElement>('.wordmark')!;
    const initials = wordmark.querySelectorAll<HTMLElement>('.wordmark-initial');
    function updateWordmark() {
      const expanded = wordmark.matches(':hover, :focus-visible');
      wordmark.classList.toggle('is-expanded', expanded);
      initials[0].textContent = expanded ? 'Y' : 'y';
      initials[1].textContent = expanded ? 'K' : 'k';
    }
    ['mouseenter', 'mouseleave', 'focus', 'blur'].forEach(event => wordmark.addEventListener(event, updateWordmark));
    const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
    const update = () => { const dark = document.documentElement.dataset.theme === 'dark'; button.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`); button.title = button.getAttribute('aria-label')!; };
    button.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {} update(); });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => { let saved; try { saved = localStorage.getItem('theme'); } catch {} if (!saved) { document.documentElement.dataset.theme = e.matches ? 'dark' : 'light'; update(); } });
    update();
  </script>
</body>
</html>
