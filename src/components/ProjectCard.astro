---
import { Image } from 'astro:assets';
import { url } from '@/lib/site';
import type { projects } from '@/lib/projects';
type Props = { project: typeof projects[number] };
const { project } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/img/**/*.{jpg,png,webp}');
const image = (await files[`/src/assets/img/${project.image}`]()).default;
---
<a class="project-card" id={`work-${project.slug}`} href={url(`blog/research/${project.slug}/`)}>
  <div class="project-image"><Image src={image} alt={project.title} widths={[400, 720, 1000]} sizes="(max-width: 700px) 92vw, 380px" format="webp" loading="lazy" /><span class="project-number">{project.number} / {project.year}</span></div>
  <div class="project-body"><p class="eyebrow">{project.label}</p><h3>{project.title}</h3><p>{project.description}</p><span class="text-link">Explore project</span></div>
</a>
